{
    "name": "podcasthosting/socialiteprovider-podcastde",
    "description": "podcast.de OAuth2 Provider for Laravel Socialite",
    "license": "MIT",
    "keywords": [
        "laravel",
        "socialite",
        "oauth",
        "oauth2",
        "podcast",
        "podcast.de"
    ],
    "homepage": "https://www.podcast.de",
    "support": {
        "issues": "https://github.com/podcasthosting/SocialiteProvider-podcastde/issues",
        "source": "https://github.com/podcasthosting/SocialiteProvider-podcastde"
    },
    "authors": [
        {
            "name": "Fabio Bacigalupo",
            "email": "support@podcast.de",
            "homepage": "https://www.podcast.de"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "socialiteproviders/manager": "^4.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Podcasthosting\\Podcastde\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Podcasthosting\\Podcastde\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "pest",
        "coverage": "pest --coverage --min=100",
        "mutate": "pest --mutate --everything --covered-only --parallel --min=100",
        "analyse": "phpstan analyse",
        "format": "php-cs-fixer fix",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
